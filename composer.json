{
    "name": "smartassert/callback-receiver-log-reader",
    "description": "",
    "keywords": [],
    "homepage": "https://github.com/smartassert/callback-receiver-log-reader",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jon Cram",
            "email": "webignition@gmail.com"
        }
    ],
    "scripts": {
        "cs-fixer-dry-run": "./vendor/bin/php-cs-fixer check --allow-risky=yes --verbose --show-progress none",
        "cs-fixer-fix": "./vendor/bin/php-cs-fixer fix --allow-risky=yes --diff",
        "cs-phpcs": "./vendor/bin/phpcs",
        "cs": [
            "@cs-fixer-dry-run",
            "@cs-phpcs"
        ],
        "static-analysis": "./vendor/bin/phpstan",
        "test-unit": "./vendor/bin/phpunit --colors=always tests/Unit",
        "test-integration": "./vendor/bin/phpunit --colors=always tests/Integration",
        "test": [
            "@test-unit",
            "@test-integration"
        ],
        "integration-up": "docker compose -f tests/build/docker-compose.yml  up -d",
        "integration-status": "docker compose -f tests/build/docker-compose.yml ps",
        "integration-logs": "docker compose -f tests/build/docker-compose.yml logs",
        "integration-setup": [
            "@integration-up"
        ],
        "integration-teardown": [
            "docker compose -f ./tests/build/docker-compose.yml down"
        ]
    },
    "autoload": {
        "psr-4": {
            "SmartAssert\\CallbackReceiverLogReader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartAssert\\CallbackReceiverLogReader\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "ext-pdo": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.13",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.2",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/process": "^8.1"
    },
    "minimum-stability":"stable",
    "prefer-stable":true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
